# Driveshaft: a console for Flywheel. Each input is compiled and run with everything entered
# before it, and only what the new input prints is shown.
#
#     import driveshaft
#     var session = driveshaft.Session()
#     print session.eval("var x = 4").status          # 0
#     print session.eval("x * 2").output              # 8
#     print driveshaft.highlight("print x * 2")       # with ANSI colors
#     print driveshaft.complete("os.ar", "import os") # ["args"]
#
# The `driveshaft` command (console.fw) is the terminal console built on this module.
import fs
import os
import time

const string VERSION = "1.0.0"
const string ESC = string(char(27))
const char NEWLINE = char(10)
const char QUOTE = char(34)
const char TICK = char(39)
const char BACKSLASH = char(92)

const string[] KEYWORDS = ["and", "as", "assert", "attr", "break", "case", "catch", "class", "component", "computed",
    "const", "constructor", "continue", "defer", "destructor", "do", "elements", "else", "end", "enum", "error",
    "extends", "finally", "for", "function", "if", "implements", "import", "in", "interface", "is", "match", "not",
    "or", "private", "protected", "public", "reactive", "readonly", "return", "returns", "run", "spawn", "static",
    "super", "this", "throw", "try", "unit", "unitconv", "unitns", "var", "when", "which", "while", "with"]
const string[] TYPES = ["bool", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "int", "float", "double",
    "string", "void", "element", "fragment", "char", "array", "tuple", "map", "set", "Result", "weak", "Error",
    "RuntimeError", "FileError", "InputError", "ProcessError", "IndexError", "KeyError", "NumericError",
    "AssertionError", "JsonError", "ResultError", "CastError", "SelectorError", "DesktopError", "RegexError",
    "NetworkError", "ValueError", "HttpError", "DatabaseError", "NativeError"]
const string[] CONSTANTS = ["true", "false", "null"]
const string[] BUILTINS = ["print", "input", "len", "typeof", "render", "string", "int", "double", "bool", "char"]
# Words that begin a statement, so the input is not tried as an expression to print.
const string[] STATEMENT_WORDS = ["var", "const", "if", "for", "while", "print", "return", "throw", "try", "match",
    "when", "assert", "defer", "reactive", "computed", "break", "continue", "spawn"]
const string[] DECLARATION_WORDS = ["import", "function", "class", "interface", "enum", "elements", "component",
    "error", "unitns", "unit", "unitconv"]
const string[] MODIFIERS = ["public", "private", "protected", "static", "readonly"]
const string[] VOID_TAGS = ["area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "source",
    "track", "wbr"]
const string[] METHODS = ["length", "upper", "lower", "trim", "trim_start", "trim_end", "split", "lines", "chars",
    "find", "find_last", "contains", "starts_with", "ends_with", "count", "replace", "pad_start", "pad_end",
    "reverse", "repeat", "is_empty", "join", "slice", "push", "pop", "insert", "remove_at", "remove", "clear",
    "extend", "sort", "index_of", "copy", "map", "filter", "reduce", "any", "all", "each", "freeze", "is_frozen",
    "keys", "values", "add", "items", "union", "intersection", "difference", "is_subset", "unwrap", "is_ok",
    "is_error", "error", "message", "name", "render", "query", "query_all", "get_by_id", "text_content",
    "children", "attributes", "append", "prepend", "set_attribute", "get_attribute", "add_class", "remove_class",
    "join", "done", "send", "receive", "close", "lock", "unlock", "to_string"]

# What each library module provides, for suggestions after `module.`.
